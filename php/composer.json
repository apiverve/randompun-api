{
    "name": "apiverve/randompun",
    "description": "Random Pun retrieves a random pun and its topic category on every request. Each call supplies the full pun text, with paid plans adding an additional humor rating score.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "randompun",
        "random pun api",
        "get random puns",
        "pun generator",
        "random wordplay",
        "daily pun"
    ],
    "homepage": "https://apiverve.com/marketplace/randompun?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/randompun",
        "source": "https://github.com/apiverve/randompun-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Randompun\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Randompun\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
